# Copy these values to .env; never commit the real API key.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash

# PostgreSQL (阿里云 RDS). These values stay only in your local .env file.
DB_ENGINE=postgresql
DB_HOST=your_rds_public_host
DB_PORT=5432
DB_NAME=aia_auto_ip
DB_USER=aia_app
DB_PASSWORD=your_database_password
DB_SSLMODE=require

# Script Recommendation production database.
# Keep these separate from DB_* when the script library uses its own RDS/database/user.
SCRIPT_DB_HOST=your_script_rds_host
SCRIPT_DB_PORT=5432
SCRIPT_DB_NAME=your_script_database
SCRIPT_DB_USER=your_script_database_user
SCRIPT_DB_PASSWORD=your_script_database_password
SCRIPT_DB_SSLMODE=disable
